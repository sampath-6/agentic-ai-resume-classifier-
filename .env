ANTHROPIC_API_KEY=CLAUDE_SECRET_KEY
ANTHROPIC_MODEL=claude-sonnet-5

UPLOAD_ROOT=./uploads/resume
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=resumes

MAX_FILE_SIZE_BYTES=2097152
MAX_PARSE_RETRIES=2
MAX_BROADEN_ATTEMPTS=2

TOP_K=20
NARRATION_COUNT=5
GUARDRAIL_KEYWORDS_PATH=./config/guardrail_keywords.txt
GRAPH_RECURSION_LIMIT=1000

ALLOWED_EMAIL=retrieve-agent-test@gmail.com
JWT_SECRET=YOUR_SECRET_KEY
JWT_EXPIRY_MINUTES=1440
CORS_ORIGINS=http://localhost:5173
