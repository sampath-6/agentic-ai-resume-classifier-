ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

UPLOAD_ROOT=./uploads/resume
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=resumes

MAX_FILE_SIZE_BYTES=2097152
MAX_PARSE_RETRIES=2
MAX_BROADEN_ATTEMPTS=2

TOP_K=20
NARRATION_COUNT=5
GUARDRAIL_KEYWORDS_PATH=./config/guardrail_keywords.txt
GRAPH_RECURSION_LIMIT=1000

# Persistent checkpointing + logging
CHECKPOINT_DB=./checkpoints.sqlite
LOG_DIR=./logs
LOG_LEVEL=INFO

# LangSmith tracing (view every run/checkpoint in the LangSmith UI)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resume-classifier
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

ALLOWED_EMAIL=your-email@example.com
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRY_MINUTES=1440
CORS_ORIGINS=http://localhost:5173

# LLM backend: anthropic (Claude API, billed) or ollama (local, free)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# hieevas evaluation tracing (empty = off)
HIEEVAS_MODE=local
HIEEVAS_TRACE_PATH=./traces/spans.jsonl
